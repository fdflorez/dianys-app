{
  "name": "dianys-app",
  "version": "1.0.0",
  "author": "Dianys Technology",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "android:sync": "ng build && cap sync android",
    "android:open": "cap open android",
    "android:run": "ionic cap run android -l --external",
    "android:dispositivos": "\"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe\" devices -l",
    "android:reverse": "\"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe\" reverse tcp:80 tcp:80",
    "android:captura": "captura.cmd",
    "build:prod": "ng build --configuration production",
    "cap:sync": "ng build --configuration production && cap sync",
    "ios:open": "cap open ios",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "assets:generate": "capacitor-assets generate --android --ios"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/angular": "^9.0.0",
    "@ionic/pwa-elements": "^3.4.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "description": "App móvil híbrida (Ionic + Angular + Capacitor) de la tienda Dianys Technology para Android e iOS"
}
